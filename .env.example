# Hobby Server Monitor - Development Configuration
#
# Copy this file to .env and set your own values.
# NEVER commit .env or real secrets to Git.
#
# Production uses a separate protected environment file:
# /etc/hobby-server-monitor/hsm.env
#
# See deploy/hsm.env.example for production defaults.

# --------------------------------------------------
# Google OAuth 2.0
# --------------------------------------------------

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4321/auth/google/callback

# --------------------------------------------------
# Authentication and sessions
# --------------------------------------------------

# Generate using:
# python3 -c "import secrets; print(secrets.token_hex(32))"

SESSION_SECRET=

# Explicit initial Admin.
# Must match a verified Google account email.

BOOTSTRAP_ADMIN_EMAIL=

SESSION_LIFETIME_SECONDS=86400

# Only false for local HTTP development.
# Use true for HTTPS deployment.

COOKIE_SECURE=false

# --------------------------------------------------
# Application storage
# --------------------------------------------------

SQLITE_DB_PATH=./data/app.db
TINYFLUX_DB_PATH=./data/metrics.csv

# --------------------------------------------------
# Host resource reserves
# --------------------------------------------------

HOST_RAM_RESERVE_BYTES=2147483648
HOST_CPU_RESERVE_THREADS=2
HOST_DISK_RESERVE_BYTES=4294967296

# Comma-separated LXD storage pools whose disk
# quota enforcement has been manually verified.

VERIFIED_DISK_QUOTA_POOLS=

# --------------------------------------------------
# Metrics collection and retention
# --------------------------------------------------

METRICS_INTERVAL_SECONDS=10
METRICS_RAW_RETENTION_HOURS=24

# --------------------------------------------------
# Container terminal restrictions
# --------------------------------------------------

TERMINAL_CONTAINER_USER=hsm-user
TERMINAL_MAX_COMMAND_LENGTH=2048
TERMINAL_MAX_OUTPUT_BYTES=65536
TERMINAL_TIMEOUT_SECONDS=10
TERMINAL_MAX_CONCURRENT_EXECS=2