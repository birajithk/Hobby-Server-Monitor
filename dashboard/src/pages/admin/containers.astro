      }

      .container-status.status-frozen {
        color: #fcd34d;
        background: #362b15;
      }

      /* MANAGEMENT GRID */

      .management-grid {
        display: grid;
        grid-template-columns: repeat(
          2,
          minmax(0, 1fr)
        );
        gap: 18px;
        align-items: stretch;
      }

      .management-grid > .panel {
        margin-top: 0;
        height: 100%;
      }

      /* ACCESS LIST */

      .access-list {
        margin: 14px 0 0;
        padding: 0;
        list-style: none;
      }

      .access-list li {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid #1f2937;
        font-size: 13px;
        line-height: 1.5;
        overflow-wrap: anywhere;
      }

      .access-list li:last-child {
        border-bottom: none;
      }

      .access-list button {
        flex-shrink: 0;
        margin: 0;
      }

      /* RESOURCE LIMITS */

      .resource-grid {
        display: grid;
        grid-template-columns: repeat(
          2,
          minmax(0, 1fr)
        );
        gap: 12px 16px;
        margin-top: 12px;
      }

      .resource-grid label {
        margin-top: 8px;
      }

      #resource-form input {
        width: 100%;
        min-width: 0;
        padding: 10px 12px;
        border: 1px solid #334155;
        border-radius: 8px;
        color: #e5e7eb;
        background: #080d16;
      }

      #resource-status {
        padding: 10px 12px;
        background: #0b111c;
        border-radius: 8px;
        overflow-wrap: anywhere;
      }

      .resource-budget-details {
        margin-top: 18px;
        padding: 12px;
        border: 1px solid #293548;
        border-radius: 8px;
        background: #0b111c;
      }

      .resource-budget-details summary {
        color: #7dd3fc;
        cursor: pointer;
        font-size: 12px;
        font-weight: 500;
      }

      .budget-content {
        margin-top: 12px;
        padding-top: 8px;
        border-top: 1px solid #293548;
      }

      .budget-content p {
        overflow-wrap: anywhere;
      }

      /* LIFECYCLE */

      .lifecycle-summary {
        display: grid;
        grid-template-columns: repeat(
          2,
          minmax(0, 1fr)
        );
        gap: 12px;
        margin-top: 18px;
      }

      .lifecycle-summary > div {
        padding: 14px;
        background: #0b111c;
        border: 1px solid #293548;
        border-radius: 8px;
        min-width: 0;
      }

      .lifecycle-summary span {
        display: block;
        color: #94a3b8;
        font-size: 12px;
      }

      .lifecycle-summary strong {
        display: block;
        margin-top: 7px;
        font-size: 16px;
        overflow-wrap: anywhere;
      }

      .lifecycle-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 18px;
      }

      .lifecycle-actions button {
        min-width: 90px;
        margin: 0;
        flex: 1 1 auto;
      }

      .lifecycle-actions .start-button {
        color: #bbf7d0;
        border-color: #166534;
        background: #123026;
      }

      .lifecycle-actions .start-button:hover:not(
          :disabled
        ) {
        background: #185038;
      }

      /* OWNERSHIP */

      .ownership-panel {
        margin-top: 0;
      }

      .ownership-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
        align-items: start;
      }

      .ownership-description p {
        max-width: 460px;
      }

      .ownership-form label:first-child {
        margin-top: 0;
      }

      .checkbox-row {
        display: flex;
        align-items: center;
        gap: 9px;
        cursor: pointer;
        line-height: 1.5;
      }

      .checkbox-row input {
        width: auto;
        flex-shrink: 0;
        margin: 0;
      }

      /* DANGER ZONE */

      .danger-panel {
        margin-top: 26px;
        margin-bottom: 30px;
        border-color: #7f1d1d;
        background: #1c1119;
      }

      .danger-panel h3 {
        color: #fca5a5;
      }

      .danger-panel-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
      }

      .danger-panel-content p {
        max-width: 680px;
        margin-bottom: 0;
      }

      .danger-panel-content button {
        margin: 0;
        flex-shrink: 0;
      }

      /* RESPONSIVE DESIGN */

      @media (max-width: 1200px) {
        .host-stats {
          grid-template-columns: repeat(
            2,
            minmax(0, 1fr)
          );
        }

        .management-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 900px) {
        .layout {
          grid-template-columns: 1fr;
        }

        .sidebar {
          display: none;
        }

        main {
          padding: 20px;
        }

        .ownership-content {
          grid-template-columns: 1fr;
          gap: 18px;
        }

        .allocation-detail-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 700px) {
        .page-header {
          flex-direction: column;
          align-items: stretch;
        }

        .header-actions {
          width: 100%;
        }

        .header-actions > * {
          flex: 1;
          text-align: center;
        }

        .host-overview-header {
          align-items: stretch;
          flex-direction: column;
        }

        .host-overview-heading {
          align-items: flex-start;
          flex-direction: column;
          gap: 5px;
        }

        .host-overview-header button {
          align-self: flex-start;
        }

        .container-selector-heading {
          align-items: stretch;
          flex-direction: column;
          gap: 18px;
        }

        .container-select-wrapper {
          width: 100%;
        }

        .selected-container-meta {
          align-items: flex-start;
          flex-direction: column;
          gap: 12px;
        }

        .danger-panel-content {
          align-items: stretch;
          flex-direction: column;
          gap: 18px;
        }

        .danger-panel-content button {
          width: 100%;
        }
      }

      @media (max-width: 500px) {
        main {
          padding: 14px;
        }

        .panel {
          padding: 16px;
        }

        .host-overview {
          padding: 14px;
        }

        .host-stats {
          grid-template-columns: 1fr;
        }

        .resource-grid {
          grid-template-columns: 1fr;
        }

        .lifecycle-summary {
          grid-template-columns: 1fr;
        }

        .access-list li {
          flex-direction: column;
          align-items: flex-start;
        }

        .access-list button {
          width: 100%;
        }

        .lifecycle-actions button {
          flex: 1 1 45%;
        }

        .page-header h2 {
          font-size: 23px;
        }
      }
    </style>

    <script>
      import {
        initializeNavigation,
      } from "../../lib/navigation.js";

      initializeNavigation();
    </script>
  </body>
</html>
