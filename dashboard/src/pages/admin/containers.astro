
---
const title = "Manage Containers — Hobby Server Monitor";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body>
    <div class="layout">
      <aside class="sidebar">
        <div>
          <h1>Hobby Server<br />Monitor</h1>
        </div>

        <nav aria-label="Main navigation">
          <a href="/" class="nav-item">Overview</a>
          <a href="/container" class="nav-item">
            Container details
          </a>
          <a href="/admin/containers" class="nav-item active">
            Manage containers
          </a>
          <a href="/admin/users" class="nav-item">Users</a>
        </nav>

        <div id="account" class="account">
          Loading account...
        </div>
      </aside>

      <main>
        <!-- PAGE HEADER -->
        <header class="page-header">
          <div>
            <div class="eyebrow">Administration</div>
            <h2>Manage containers</h2>
            <p>
              Control container access, ownership,
              resource limits and lifecycle.
            </p>
          </div>

          <div class="header-actions">
            <a
              href="/admin/containers/new"
              class="create-container-link"
            >
              + Create container
            </a>

            <button id="refresh-button" type="button">
              Refresh
            </button>
          </div>
        </header>

        <div
          id="notice"
          class="message hidden"
          role="status"
          aria-live="polite"
        ></div>

        <!-- COMPACT HOST ALLOCATION OVERVIEW -->
        <section
          class="host-overview"
          id="host-allocation-panel"
        >
          <div class="host-overview-header">
            <div class="host-overview-heading">
              <h3>Host allocation</h3>
              <span class="muted">
                Overall server resource availability
              </span>
            </div>

            <button
              id="refresh-allocations-button"
              type="button"
              class="secondary-button"
            >
              Refresh allocations
            </button>
          </div>

          <div class="host-stats">
            <div class="host-stat">
              <span class="stat-label">RAM</span>
              <strong id="allocation-ram">
                Loading...
              </strong>
              <span class="stat-description">
                Allocated / Total
              </span>
            </div>

            <div class="host-stat">
              <span class="stat-label">CPU</span>
              <strong id="allocation-cpu">
                Loading...
              </strong>
              <span class="stat-description">
                Allocated / Total threads
              </span>
            </div>

            <div class="host-stat">
              <span class="stat-label">Containers</span>
              <strong id="allocation-containers">
                Loading...
              </strong>
              <span class="stat-description">
                Managed / Unmanaged
              </span>
            </div>

            <div class="host-stat">
              <span class="stat-label">Allocation status</span>
              <strong id="allocation-status">
                Loading...
              </strong>
              <span class="stat-description">
                Host accounting
              </span>
            </div>
          </div>

          <details class="allocation-details">
            <summary>
              View detailed host allocation
            </summary>

            <div class="allocation-details-content">
              <div class="allocation-detail-grid">
                <div class="allocation-card">
                  <h4>RAM allocation</h4>
                  <p id="allocation-ram-details">
                    Loading...
                  </p>
                </div>

                <div class="allocation-card">
                  <h4>CPU allocation</h4>
                  <p id="allocation-cpu-details">
                    Loading...
                  </p>
                </div>
              </div>

              <h4>Storage pool allocations</h4>

              <div id="allocation-storage">
                Loading storage pools...
              </div>

              <h4>Allocation blockers</h4>

              <ul id="allocation-blockers">
                <li>Loading...</li>
              </ul>

              <p class="muted">
                Stopped managed containers still count
                towards committed host allocations.
              </p>
            </div>
          </details>
        </section>

        <!-- CONTAINER SELECTION -->
        <section class="panel container-selector-panel">
          <div class="container-selector-heading">
            <div>
              <div class="section-eyebrow">
                SELECTED CONTAINER
              </div>

              <h3>Managed container</h3>

              <p id="container-summary" class="muted">
                Select a managed container.
              </p>
            </div>

            <div class="container-select-wrapper">
              <label for="container-select">
                Container
              </label>

              <select id="container-select">
                <option value="">
                  Loading containers...
                </option>
              </select>
            </div>
          </div>

          <div class="selected-container-meta">
            <span
              id="owner-summary"
              class="muted"
            ></span>

            <div class="selected-state">
              <span class="muted">Current state:</span>
              <strong id="selected-container-status">
                —
              </strong>
            </div>
          </div>
        </section>

        <!-- ACCESS MANAGEMENT -->
        <div class="section-heading">
          <h3>Access management</h3>
          <p class="muted">
            Review and manage who can access this container.
          </p>
        </div>

        <div class="management-grid">
          <!-- CURRENT ACCESS -->
          <section class="panel">
            <h3>Current access</h3>

            <p class="muted">
              An owner's access cannot be removed
              without transferring ownership.
            </p>

            <ul id="access-list" class="access-list">
              <li>Loading...</li>
            </ul>
          </section>

          <!-- ASSIGN ACCESS -->
          <section class="panel">
            <h3>Assign container access</h3>

            <p class="muted">
              Additional access does not charge
              the user's quota.
            </p>

            <label for="assignment-user">
              Active Container User
            </label>

            <select id="assignment-user" disabled>
              <option value="">
                Select a user
              </option>
            </select>

            <button
              id="assign-button"
              type="button"
              class="primary-button"
              disabled
            >
              Assign access
            </button>
          </section>
        </div>

        <!-- CONTAINER OPERATIONS -->
        <div class="section-heading">
          <h3>Container operations</h3>
          <p class="muted">
            Configure allocated resources and
            manage the container's running state.
          </p>
        </div>

        <div class="management-grid">
          <!-- RESOURCE LIMITS -->
          <section class="panel" id="resource-panel">
            <h3>Edit resource limits</h3>

            <p class="muted">
              Edit the selected managed container's
              allocated resources. Disk limits can
              increase but cannot decrease.
            </p>

            <p id="resource-status" class="muted">
              Select a container to load saved limits.
            </p>

            <form id="resource-form">
              <div class="resource-grid">
                <div>
                  <label for="resource-ram">
                    RAM (GiB)
                  </label>

                  <input
                    id="resource-ram"
                    type="number"
                    min="0.25"
                    step="any"
                    required
                  />
                </div>

                <div>
                  <label for="resource-cpu">
                    CPU cores
                  </label>

                  <input
                    id="resource-cpu"
                    type="number"
                    min="1"
                    step="1"
                    required
                  />
                </div>

                <div>
                  <label for="resource-allowance">
                    CPU allowance (%)
                  </label>

                  <input
                    id="resource-allowance"
                    type="number"
                    min="1"
                    max="100"
                    step="1"
                    required
                  />
                </div>

                <div>
                  <label for="resource-disk">
                    Disk (GiB)
                  </label>

                  <input
                    id="resource-disk"
                    type="number"
                    min="0.25"
                    step="any"
                    required
                  />
                </div>
              </div>

              <details class="resource-budget-details">
                <summary>
                  View quota and allocation budgets
                </summary>

                <div class="budget-content">
                  <p
                    id="resource-owner-budget"
                    class="muted"
                  ></p>

                  <p
                    id="resource-host-budget"
                    class="muted"
                  ></p>
                </div>
              </details>

              <button
                id="save-resource-button"
                type="submit"
                class="primary-button"
                disabled
              >
                Save resource limits
              </button>
            </form>
          </section>

          <!-- LIFECYCLE -->
          <section class="panel" id="lifecycle-panel">
            <h3>Container lifecycle</h3>

            <p class="muted">
              Start, stop, restart, freeze or unfreeze
              the selected managed container.
            </p>

            <div class="lifecycle-summary">
              <div>
                <span>Selected container</span>

                <strong id="lifecycle-name">
                  —
                </strong>
              </div>

              <div>
                <span>Current state</span>

                <strong id="lifecycle-status">
                  —
                </strong>
              </div>
            </div>

            <div class="lifecycle-actions">
              <button
                type="button"
                data-lifecycle-action="start"
                class="start-button"
                disabled
              >
                Start
              </button>

              <button
                type="button"
                data-lifecycle-action="stop"
                disabled
              >
                Stop
              </button>

              <button
                type="button"
                data-lifecycle-action="restart"
                disabled
              >
                Restart
              </button>

              <button
                type="button"
                data-lifecycle-action="freeze"
                disabled
              >
                Freeze
              </button>

              <button
                type="button"
                data-lifecycle-action="unfreeze"
                disabled
              >
                Unfreeze
              </button>
            </div>
          </section>
        </div>

        <!-- OWNERSHIP MANAGEMENT -->
        <div class="section-heading">
          <h3>Ownership management</h3>
          <p class="muted">
            Transfer responsibility for a container
            to another active user.
          </p>
        </div>

        <section class="panel ownership-panel">
          <div class="ownership-content">
            <div class="ownership-description">
              <h3>Transfer ownership</h3>

              <p class="muted">
                The receiving owner's RAM, CPU and
                disk quotas are validated by Falcon
                before ownership changes.
              </p>
            </div>

            <div class="ownership-form">
              <label for="new-owner">
                New owner
              </label>

              <select id="new-owner" disabled>
                <option value="">
                  Select a user
                </option>
              </select>

              <label
                class="checkbox-row"
                for="keep-access"
              >
                <input
                  id="keep-access"
                  type="checkbox"
                  checked
                />
                Keep the previous owner's
                container access
              </label>

              <button
                id="transfer-button"
                type="button"
                disabled
              >
                Transfer ownership
              </button>
            </div>
          </div>
        </section>

        <!-- DANGER ZONE -->
        <section class="panel danger-panel">
          <div class="danger-panel-content">
            <div>
              <h3>Danger zone</h3>

              <p class="muted">
                Permanently deleting a container
                destroys its LXD instance and filesystem.
                Its application allocation and access
                records will also be removed.
              </p>
            </div>

            <button
              id="delete-container-button"
              type="button"
              class="danger"
              disabled
            >
              Delete container permanently
            </button>
          </div>
        </section>
      </main>
    </div>

    <!-- APPLICATION LOGIC -->
    <script>
      import {
        getCurrentUser,
        getContainers,
        getAdminUsers,
        getAdminContainerAccess,
        assignContainerAccess,
        revokeContainerAccess,
        transferContainerOwner,
        performContainerAction,
        deleteManagedContainer,
        getAdminHost,
        getAdminAllocations,
        getContainerResourceLimits,
        updateContainerResourceLimits,
      } from "../../lib/api.js";

      const $ = (selector) =>
        document.querySelector(selector);

      const containerSelect = $("#container-select");
      const assignmentSelect = $("#assignment-user");
      const ownerSelect = $("#new-owner");
      const accessList = $("#access-list");
      const assignButton = $("#assign-button");
      const transferButton = $("#transfer-button");
      const refreshButton = $("#refresh-button");
      const notice = $("#notice");

      let csrfToken = "";
      let allUsers = [];
      let managedContainers = [];
      let currentAccess = null;
      let busy = false;

      let resourceLimits = null;
      let allocationReport = null;
      let hostInformation = null;
      let resourceLoading = false;

      const GiB = 1024 ** 3;

      const resourceForm = $("#resource-form");
      const saveResourceButton = $("#save-resource-button");

      function formatGiB(bytes) {
        return `${(Number(bytes) / GiB).toFixed(2)} GiB`;
      }

      function remainingQuota(user, key) {
        return Math.max(
          0,
          Number(user?.quota?.[key] || 0) -
            Number(user?.allocation?.[key] || 0),
        );
      }

      function resetResourceForm() {
        resourceLimits = null;
        resourceForm.reset();

        $("#resource-status").textContent =
          "Loading saved resource limits...";

        $("#resource-owner-budget").textContent = "";
        $("#resource-host-budget").textContent = "";

        saveResourceButton.disabled = true;
      }

      function showNotice(message, kind = "error") {
        notice.textContent = message;
        notice.className = `message ${kind}`;
      }

      function clearNotice() {
        notice.textContent = "";
        notice.className = "message hidden";
      }

      function userLabel(user) {
        return user.name
          ? `${user.name} (${user.email})`
          : user.email;
      }

      function setOptions(select, records, label) {
        select.replaceChildren(new Option(label, ""));

        for (const record of records) {
          select.add(
            new Option(record.label, record.value),
          );
        }
      }

      const lifecyclePermissions = {
        start: ["Stopped"],
        stop: ["Running", "Frozen"],
        restart: ["Running"],
        freeze: ["Running"],
        unfreeze: ["Frozen"],
      };

      function selectedManagedContainer() {
        return (
          managedContainers.find(
            (container) =>
              container.id === containerSelect.value &&
              container.managed !== false,
          ) || null
        );
      }

      function updateLifecycleControls() {
        const container = selectedManagedContainer();

        const name =
          container?.name ||
          container?.lxd_name ||
          "—";

        const status =
          container?.status || "Unknown";

        $("#lifecycle-name").textContent = name;
        $("#lifecycle-status").textContent = status;

        // Update status in main container selector.
        const selectedStatus = $(
          "#selected-container-status",
        );

        if (selectedStatus) {
          selectedStatus.textContent = status;

          selectedStatus.className =
            `container-status status-${status.toLowerCase()}`;
        }

        document.querySelectorAll(
          "[data-lifecycle-action]",
        ).forEach((button) => {
          const action =
            button.dataset.lifecycleAction;

          const allowedStates =
            lifecyclePermissions[action] || [];

          button.disabled =
            busy ||
            !container ||
            !allowedStates.includes(status);
        });

        $("#delete-container-button").disabled =
          busy || !container;
      }

      function syncButtons() {
        $("#refresh-allocations-button").disabled = busy;

        saveResourceButton.disabled =
          busy ||
          resourceLoading ||
          !resourceLimits;

        containerSelect.disabled =
          busy || managedContainers.length === 0;

        refreshButton.disabled = busy;

        assignmentSelect.disabled =
          busy || assignmentSelect.options.length <= 1;

        ownerSelect.disabled =
          busy || ownerSelect.options.length <= 1;

        assignButton.disabled =
          busy || !assignmentSelect.value;

        transferButton.disabled =
          busy || !ownerSelect.value;

        for (const button of accessList.querySelectorAll(
          "button",
        )) {
          button.disabled = busy;
        }

        updateLifecycleControls();
      }

      function setBusy(value) {
        busy = value;
        syncButtons();
      }

      function renderAccess(access) {
        currentAccess = access;

        const owner = allUsers.find(
          (user) => user.id === access.owner_id,
        );

        $("#owner-summary").textContent =
          `Current owner: ${
            owner ? userLabel(owner) : access.owner_id
          }`;

        accessList.replaceChildren();

        for (const user of access.users || []) {
          const item = document.createElement("li");
          const label = document.createElement("span");

          label.textContent =
            `${user.name || user.email} — ` +
            `${
              user.is_owner
                ? "Owner"
                : "Assigned user"
            } (${user.status})`;

          item.append(label);

          if (!user.is_owner) {
            const remove =
              document.createElement("button");

            remove.type = "button";
            remove.className = "danger";
            remove.textContent = "Remove access";

            remove.addEventListener(
              "click",
              async () => {
                if (
                  !window.confirm(
                    `Remove ${user.email}'s access to this container?`,
                  )
                ) {
                  return;
                }

                await runMutation(
                  () =>
                    revokeContainerAccess(
                      containerSelect.value,
                      user.id,
                      csrfToken,
                    ),
                  "Container access removed.",
                );
              },
            );

            item.append(remove);
          }

          accessList.append(item);
        }

        if (!accessList.children.length) {
          const empty = document.createElement("li");

          empty.textContent =
            "No access records found.";

          accessList.append(empty);
        }

        const assignedIds = new Set(
          (access.users || []).map(
            (user) => user.id,
          ),
        );

        const assignable = allUsers
          .filter(
            (user) =>
              user.status === "active" &&
              user.role === "container_user" &&
              !assignedIds.has(user.id),
          )
          .map((user) => ({
            value: user.id,
            label: userLabel(user),
          }));

        setOptions(
          assignmentSelect,
          assignable,
          "Select a user",
        );

        const possibleOwners = allUsers
          .filter(
            (user) =>
              user.status === "active" &&
              user.id !== access.owner_id,
          )
          .map((user) => ({
            value: user.id,
            label: userLabel(user),
          }));

        setOptions(
          ownerSelect,
          possibleOwners,
          "Select new owner",
        );

        syncButtons();
      }

      async function loadResourceLimits() {
        const containerId = containerSelect.value;

        resetResourceForm();

        if (!containerId) {
          $("#resource-status").textContent =
            "No managed container selected.";
          return;
        }

        resourceLoading = true;
        syncButtons();

        try {
          const result =
            await getContainerResourceLimits(
              containerId,
            );

          if (containerSelect.value !== containerId) {
            return;
          }

          resourceLimits = result;

          $("#resource-ram").value = String(
            result.ram_limit_bytes / GiB,
          );

          $("#resource-cpu").value = String(
            result.cpu_limit_cores,
          );

          $("#resource-allowance").value = String(
            result.cpu_allowance_percent,
          );

          $("#resource-disk").value = String(
            result.disk_limit_bytes / GiB,
          );

          $("#resource-disk").min = String(
            result.disk_limit_bytes / GiB,
          );

          $("#resource-status").textContent =
            `Saved limits loaded for ${result.name}. ` +
            `Storage pool: ${result.storage_pool}.`;

          updateResourceBudget();
        } catch (error) {
          if (containerSelect.value === containerId) {
            $("#resource-status").textContent =
              error?.message ||
              "Unable to load resource limits.";
          }
        } finally {
          resourceLoading = false;
          syncButtons();
        }
      }

      function updateResourceBudget() {
        if (!resourceLimits || !allocationReport) {
          return;
        }

        const owner = allUsers.find(
          (user) =>
            user.id === resourceLimits.owner_id,
        );

        const pool =
          allocationReport.storage_pools?.find(
            (item) =>
              item.name === resourceLimits.storage_pool,
          );

        const ownerRemainingRam = remainingQuota(
          owner,
          "ram_bytes",
        );

        const ownerRemainingCpu = remainingQuota(
          owner,
          "cpu_cores",
        );

        const ownerRemainingDisk = remainingQuota(
          owner,
          "disk_bytes",
        );

        const hostRemainingRam = Number(
          allocationReport.memory?.allocatable_bytes || 0,
        );

        const hostRemainingCpu = Number(
          allocationReport.cpu?.allocatable_threads || 0,
        );

        const hostRemainingDisk = Number(
          pool?.allocatable_bytes || 0,
        );

        const ownerRam =
          ownerRemainingRam +
          resourceLimits.ram_limit_bytes;

        const ownerCpu =
          ownerRemainingCpu +
          resourceLimits.cpu_limit_cores;

        const ownerDisk =
          ownerRemainingDisk +
          resourceLimits.disk_limit_bytes;

        const hostRam =
          hostRemainingRam +
          resourceLimits.ram_limit_bytes;

        const hostCpu =
          hostRemainingCpu +
          resourceLimits.cpu_limit_cores;

        const hostDisk =
          hostRemainingDisk +
          resourceLimits.disk_limit_bytes;

        $("#resource-owner-budget").textContent =
          `Owner remaining quota: ` +
          `RAM ${formatGiB(ownerRemainingRam)}, ` +
          `CPU ${ownerRemainingCpu}, ` +
          `disk ${formatGiB(ownerRemainingDisk)}. ` +
          `Maximum for this container: ` +
          `RAM ${formatGiB(ownerRam)}, ` +
          `CPU ${ownerCpu}, ` +
          `disk ${formatGiB(ownerDisk)}.`;

        $("#resource-host-budget").textContent =
          `Host remaining allocation budget: ` +
          `RAM ${formatGiB(hostRemainingRam)}, ` +
          `CPU ${hostRemainingCpu}, ` +
          `disk ${formatGiB(hostRemainingDisk)}. ` +
          `Maximum for this container: ` +
          `RAM ${formatGiB(hostRam)}, ` +
          `CPU ${hostCpu}, ` +
          `disk ${formatGiB(hostDisk)}. ` +
          `Storage pool: ${resourceLimits.storage_pool}.`;

        $("#resource-ram").max = String(
          Math.min(ownerRam, hostRam) / GiB,
        );

        $("#resource-cpu").max = String(
          Math.min(ownerCpu, hostCpu),
        );

        $("#resource-disk").max = String(
          Math.min(ownerDisk, hostDisk) / GiB,
        );

        const blocked =
          (allocationReport.blockers || []).length > 0;

        $("#resource-status").textContent = blocked
          ? "Host allocation blockers exist. Resource increases are not permitted until reconciliation."
          : `Saved limits loaded for ${resourceLimits.name}.`;

        saveResourceButton.disabled =
          busy ||
          resourceLoading ||
          !owner ||
          !pool;
      }

      async function loadAccess() {
        const id = containerSelect.value;

        currentAccess = null;
        accessList.replaceChildren();
        $("#owner-summary").textContent = "";

        if (!id) {
          syncButtons();
          return;
        }

        const result =
          await getAdminContainerAccess(id);

        if (containerSelect.value !== id) {
          return;
        }

        renderAccess(result);
      }

      // Compact overview with detailed allocation
      // information inside the expandable section.
      function renderHostOverview() {
        const report = allocationReport;

        if (!report || !hostInformation) {
          return;
        }

        const ram = report.memory;
        const cpu = report.cpu;

        // Compact RAM summary.
        $("#allocation-ram").textContent =
          `${formatGiB(ram.allocated_bytes)} / ` +
          `${formatGiB(ram.total_bytes)}`;

        // Compact CPU summary.
        $("#allocation-cpu").textContent =
          `${cpu.allocated_threads} / ` +
          `${cpu.total_threads} threads`;

        // Container counts.
        $("#allocation-containers").textContent =
          `${report.managed_count} managed · ` +
          `${report.unmanaged_count} unmanaged`;

        const blockers = report.blockers || [];

        // Compact allocation status.
        const statusElement = $("#allocation-status");

        statusElement.textContent =
          blockers.length
            ? "Allocations blocked"
            : "No blockers";

        statusElement.className =
          blockers.length
            ? "allocation-state blocked"
            : "allocation-state healthy";

        // Full RAM details.
        $("#allocation-ram-details").textContent =
          `Total: ${formatGiB(ram.total_bytes)} | ` +
          `Reserved: ${formatGiB(ram.reserve_bytes)} | ` +
          `Allocated: ${formatGiB(ram.allocated_bytes)} | ` +
          `Allocatable: ${formatGiB(ram.allocatable_bytes)}`;

        // Full CPU details.
        $("#allocation-cpu-details").textContent =
          `Total: ${cpu.total_threads} threads | ` +
          `Reserved: ${cpu.reserve_threads} | ` +
          `Allocated: ${cpu.allocated_threads} | ` +
          `Allocatable: ${cpu.allocatable_threads}`;

        const storageElement = $("#allocation-storage");
        storageElement.replaceChildren();

        for (const pool of report.storage_pools || []) {
          const hostPool =
            hostInformation.storage_pools?.find(
              (item) => item.name === pool.name,
            );

          const card = document.createElement("div");
          card.className = "allocation-card";

          const heading =
            document.createElement("h4");

          heading.textContent =
            `${pool.name} (${pool.driver})`;

          const details =
            document.createElement("p");

          details.textContent =
            `Total: ${
              hostPool
                ? formatGiB(hostPool.total_bytes)
                : "Unknown"
            } | ` +
            `Used: ${
              hostPool
                ? formatGiB(hostPool.used_bytes)
                : "Unknown"
            } | ` +
            `Free: ${formatGiB(pool.free_bytes)} | ` +
            `Reserved: ${formatGiB(pool.reserve_bytes)} | ` +
            `Allocated: ${formatGiB(pool.allocated_bytes)} | ` +
            `Allocatable: ${formatGiB(pool.allocatable_bytes)}`;

          const verification =
            document.createElement("p");

          verification.className = "muted";

          verification.textContent =
            pool.disk_quota_verified
              ? "Disk quota enforcement verified"
              : "Disk quota enforcement not verified — new disk allocations disabled";

          card.append(
            heading,
            details,
            verification,
          );

          storageElement.append(card);
        }

        if (!storageElement.children.length) {
          storageElement.textContent =
            "No storage pools reported.";
        }

        const blockersList = $("#allocation-blockers");
        blockersList.replaceChildren();

        if (!blockers.length) {
          const item = document.createElement("li");

          item.textContent =
            "No reconciliation blockers.";

          blockersList.append(item);
        } else {
          for (const blocker of blockers) {
            const item =
              document.createElement("li");

            item.textContent = blocker;
            blockersList.append(item);
          }
        }

        $("#refresh-allocations-button").disabled = busy;
      }

      async function loadAll() {
        const previousId = containerSelect.value;

        const [
          containerResponse,
          userResponse,
          allocations,
          host,
        ] = await Promise.all([
          getContainers(),
          getAdminUsers(),
          getAdminAllocations(),
          getAdminHost(),
        ]);

        allocationReport = allocations;
        hostInformation = host;

        const allContainers = Array.isArray(
          containerResponse,
        )
          ? containerResponse
          : containerResponse?.containers || [];

        managedContainers = allContainers.filter(
          (container) =>
            typeof container.id === "string" &&
            container.id.length > 0 &&
            typeof container.owner_id === "string",
        );

        allUsers = Array.isArray(userResponse?.users)
          ? userResponse.users
          : [];

        setOptions(
          containerSelect,
          managedContainers.map((container) => ({
            value: container.id,
            label:
              container.lxd_name ||
              container.name ||
              container.id,
          })),
          "Select managed container",
        );

        if (
          managedContainers.some(
            (item) => item.id === previousId,
          )
        ) {
          containerSelect.value = previousId;
        } else if (managedContainers.length) {
          containerSelect.value =
            managedContainers[0].id;
        }

        $("#container-summary").textContent =
          `${managedContainers.length} managed container(s) available`;

        await Promise.all([
          loadAccess(),
          loadResourceLimits(),
        ]);

        renderHostOverview();
        updateResourceBudget();
        syncButtons();
      }

      async function runMutation(operation, successText) {
        if (busy || !csrfToken || !currentAccess) {
          return;
        }

        clearNotice();
        setBusy(true);

        try {
          await operation();
          await loadAll();
          showNotice(successText, "success");
        } catch (error) {
          showNotice(
            error?.message || "Operation failed.",
          );
        } finally {
          setBusy(false);
        }
      }

      async function executeLifecycleAction(action) {
        const container = selectedManagedContainer();

        if (!container || busy || !csrfToken) {
          return;
        }

        const allowedStates =
          lifecyclePermissions[action] || [];

        if (!allowedStates.includes(container.status)) {
          showNotice(
            `Cannot ${action} ${container.name} while it is ${container.status}. Refresh the container list.`,
          );
          return;
        }

        const name =
          container.name || container.lxd_name;

        if (["stop", "restart"].includes(action)) {
          const confirmed = window.confirm(
            `${action.toUpperCase()} ${name}?\n\n` +
              "This may interrupt running applications or active terminal commands.",
          );

          if (!confirmed) {
            return;
          }
        }

        clearNotice();
        setBusy(true);

        try {
          const result =
            await performContainerAction(
              container.id,
              action,
              csrfToken,
            );

          try {
            await loadAll();

            showNotice(
              `${name}: ${action} successful. New state: ${result.status}.`,
              "success",
            );
          } catch (refreshError) {
            console.warn(
              "Lifecycle action completed, but the refresh failed:",
              refreshError,
            );

            showNotice(
              `${name}: ${action} completed, but the container list could not be refreshed.`,
              "success",
            );
          }
        } catch (error) {
          showNotice(
            error?.message ||
              `Could not confirm the ${action} operation. Refresh the list to check its state.`,
          );
        } finally {
          setBusy(false);
        }
      }

      async function permanentlyDeleteContainer() {
        const container = selectedManagedContainer();

        if (!container || busy || !csrfToken) {
          return;
        }

        const name =
          container.name || container.lxd_name;

        const typedName = window.prompt(
          `PERMANENTLY DELETE ${name}?\n\n` +
            "This will destroy the container and its filesystem.\n" +
            "This operation cannot be undone.\n\n" +
            `Type "${name}" to continue:`,
        );

        if (typedName === null) {
          return;
        }

        if (typedName !== name) {
          showNotice(
            "Deletion cancelled: container name did not match.",
          );
          return;
        }

        const confirmed = window.confirm(
          `Final confirmation:\n\n` +
            `Permanently delete ${name} and all its data?`,
        );

        if (!confirmed) {
          return;
        }

        clearNotice();
        setBusy(true);

        try {
          await deleteManagedContainer(
            container.id,
            csrfToken,
          );

          try {
            if (
              sessionStorage.getItem(
                "hsm:last-container-id",
              ) === container.id
            ) {
              sessionStorage.removeItem(
                "hsm:last-container-id",
              );
            }
          } catch {
            // Continue without session storage.
          }

          try {
            await loadAll();

            showNotice(
              `${name} was permanently deleted.`,
              "success",
            );
          } catch (refreshError) {
            console.warn(
              "Container deleted, but unable to refresh:",
              refreshError,
            );

            showNotice(
              `${name} was deleted, but the container list could not be refreshed.`,
              "success",
            );
          }
        } catch (error) {
          showNotice(
            error?.message ||
              "Deletion could not be confirmed. Check LXD before retrying.",
          );
        } finally {
          setBusy(false);
        }
      }

      // EVENT HANDLERS
      $("#delete-container-button").addEventListener(
        "click",
        permanentlyDeleteContainer,
      );

      containerSelect.addEventListener(
        "change",
        () => {
          clearNotice();
          updateLifecycleControls();

          loadAccess().catch((error) => {
            showNotice(
              error?.message ||
                "Unable to load container access.",
            );
          });

          loadResourceLimits().catch((error) => {
            showNotice(
              error?.message ||
                "Unable to load resource limits.",
            );
          });
        },
      );

      assignmentSelect.addEventListener(
        "change",
        syncButtons,
      );

      ownerSelect.addEventListener(
        "change",
        syncButtons,
      );

      assignButton.addEventListener("click", () => {
        const containerId = containerSelect.value;
        const userId = assignmentSelect.value;

        if (!containerId || !userId) {
          return;
        }

        runMutation(
          () =>
            assignContainerAccess(
              containerId,
              userId,
              csrfToken,
            ),
          "Container access assigned.",
        );
      });

      transferButton.addEventListener("click", () => {
        const containerId = containerSelect.value;
        const newOwnerId = ownerSelect.value;
        const keepPrevious = $("#keep-access").checked;

        if (!containerId || !newOwnerId) {
          return;
        }

        const nextOwner = allUsers.find(
          (user) => user.id === newOwnerId,
        );

        if (
          !window.confirm(
            `Transfer ownership to ${
              nextOwner
                ? userLabel(nextOwner)
                : newOwnerId
            }?\n\nThe new owner's quota will be charged.`,
          )
        ) {
          return;
        }

        runMutation(
          () =>
            transferContainerOwner(
              containerId,
              newOwnerId,
              keepPrevious,
              csrfToken,
            ),
          "Container ownership transferred.",
        );
      });

      refreshButton.addEventListener(
        "click",
        async () => {
          clearNotice();
          setBusy(true);

          try {
            await loadAll();

            showNotice(
              "Container data refreshed.",
              "success",
            );
          } catch (error) {
            showNotice(
              error?.message ||
                "Unable to refresh.",
            );
          } finally {
            setBusy(false);
          }
        },
      );

      $("#refresh-allocations-button").addEventListener(
        "click",
        async () => {
          if (busy) {
            return;
          }

          clearNotice();
          setBusy(true);

          try {
            const [allocations, host] =
              await Promise.all([
                getAdminAllocations(),
                getAdminHost(),
              ]);

            allocationReport = allocations;
            hostInformation = host;

            renderHostOverview();
            updateResourceBudget();

            showNotice(
              "Host allocation overview refreshed.",
              "success",
            );
          } catch (error) {
            showNotice(
              error?.message ||
                "Unable to refresh host allocation overview.",
            );
          } finally {
            setBusy(false);
          }
        },
      );

      document.querySelectorAll(
        "[data-lifecycle-action]",
      ).forEach((button) => {
        button.addEventListener("click", () => {
          executeLifecycleAction(
            button.dataset.lifecycleAction,
          );
        });
      });

      resourceForm.addEventListener(
        "submit",
        async (event) => {
          event.preventDefault();

          if (
            busy ||
            resourceLoading ||
            !resourceLimits ||
            !csrfToken
          ) {
            return;
          }

          if (!resourceForm.reportValidity()) {
            return;
          }

          const containerId = resourceLimits.id;

          if (containerSelect.value !== containerId) {
            showNotice(
              "Container selection changed. Refresh first.",
            );
            return;
          }

          const payload = {
            ram_limit_bytes: Math.round(
              Number($("#resource-ram").value) * GiB,
            ),

            cpu_limit_cores: Number(
              $("#resource-cpu").value,
            ),

            cpu_allowance_percent: Number(
              $("#resource-allowance").value,
            ),

            disk_limit_bytes: Math.round(
              Number($("#resource-disk").value) * GiB,
            ),
          };

          const saved = resourceLimits;

          if (
            !Number.isSafeInteger(
              payload.ram_limit_bytes,
            ) ||
            !Number.isSafeInteger(
              payload.disk_limit_bytes,
            ) ||
            !Number.isSafeInteger(
              payload.cpu_limit_cores,
            ) ||
            !Number.isSafeInteger(
              payload.cpu_allowance_percent,
            ) ||
            payload.ram_limit_bytes <= 0 ||
            payload.disk_limit_bytes <= 0 ||
            payload.cpu_limit_cores <= 0 ||
            payload.cpu_allowance_percent < 1 ||
            payload.cpu_allowance_percent > 100
          ) {
            showNotice("Invalid resource values.");
            return;
          }

          if (
            payload.disk_limit_bytes <
            saved.disk_limit_bytes
          ) {
            showNotice(
              "Reducing a root-disk limit is not supported.",
            );
            return;
          }

          const increased =
            payload.ram_limit_bytes >
              saved.ram_limit_bytes ||
            payload.cpu_limit_cores >
              saved.cpu_limit_cores ||
            payload.disk_limit_bytes >
              saved.disk_limit_bytes;

          if (
            increased &&
            allocationReport?.blockers?.length
          ) {
            showNotice(
              "Host allocation blockers must be resolved before increasing limits.",
            );
            return;
          }

          clearNotice();
          setBusy(true);

          try {
            await updateContainerResourceLimits(
              containerId,
              payload,
              csrfToken,
            );

            try {
              await loadAll();

              showNotice(
                "Resource limits updated successfully.",
                "success",
              );
            } catch (error) {
              showNotice(
                "Update completed, but refresh failed. Reload before editing again.",
                "success",
              );
            }
          } catch (error) {
            showNotice(
              error?.message ||
                "Resource update failed.",
            );

            try {
              await loadAll();
            } catch {
              resourceLimits = null;
              saveResourceButton.disabled = true;
            }
          } finally {
            setBusy(false);
          }
        },
      );

      async function initialize() {
        try {
          const response = await getCurrentUser();
          const user = response.user || response;

          if (user.role !== "admin") {
            showNotice(
              "403 — Administrator access is required.",
            );
            return;
          }

          csrfToken =
            response.csrf_token ||
            user.csrf_token ||
            "";

          if (!csrfToken) {
            showNotice(
              "CSRF token is unavailable.",
            );
            return;
          }

          $("#account").replaceChildren();

          const name =
            document.createElement("strong");

          name.textContent =
            user.name || user.email || "Admin";

          const role =
            document.createElement("span");

          role.textContent = "Admin";

          $("#account").append(name, role);

          await loadAll();
          clearNotice();
        } catch (error) {
          showNotice(
            error?.message ||
              "Unable to load management page.",
          );
        }
      }

      initialize();
    </script>

