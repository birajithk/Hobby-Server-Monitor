# Hobby Server Monitor - Production Environment
#
# Deployment location:
# /etc/hobby-server-monitor/hsm.env
#
# Production environment file permissions:
# Owner: root
# Group: root
# Mode: 0600
#
# Never commit actual secrets.

# --------------------------------------------------
# Google OAuth
# --------------------------------------------------

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Replace YOUR_HOSTNAME with the actual HTTPS hostname.
# Must exactly match the Google Cloud OAuth redirect URI.

GOOGLE_OAUTH_REDIRECT_URI=https://YOUR_HOSTNAME/auth/google/callback

# --------------------------------------------------
# Authentication
# --------------------------------------------------

BOOTSTRAP_ADMIN_EMAIL=

SESSION_SECRET=
SESSION_LIFETIME_SECONDS=86400

# Always true when using HTTPS in production.

COOKIE_SECURE=true

# --------------------------------------------------
# Persistent application storage
# --------------------------------------------------

SQLITE_DB_PATH=/var/lib/hobby-server-monitor/app.db
TINYFLUX_DB_PATH=/var/lib/hobby-server-monitor/metrics.csv

# --------------------------------------------------
# Host resource reserves
# --------------------------------------------------

HOST_RAM_RESERVE_BYTES=2147483648
HOST_CPU_RESERVE_THREADS=2
HOST_DISK_RESERVE_BYTES=4294967296

# Use only storage pools whose quotas were
# actually verified against LXD.

VERIFIED_DISK_QUOTA_POOLS=

# --------------------------------------------------
# Independent metrics collector
# --------------------------------------------------

METRICS_INTERVAL_SECONDS=10
METRICS_RAW_RETENTION_HOURS=24

# --------------------------------------------------
# Restricted container terminal
# --------------------------------------------------

TERMINAL_CONTAINER_USER=hsm-user

TERMINAL_MAX_COMMAND_LENGTH=2048
TERMINAL_MAX_OUTPUT_BYTES=65536
TERMINAL_TIMEOUT_SECONDS=10
TERMINAL_MAX_CONCURRENT_EXECS=2
